# Copy to a PRIVATE file outside the repository, e.g. /root/tpctf.env (chmod 600).
CTFY_URL=https://ctfy.tsinghua.edu.cn
CTFY_TOKEN=pf_REPLACE_WITH_AGENT_PLAY_TOKEN
CTFY_COMPETITION_ID=REPLACE_WITH_TRACK_ID

# Nov 14: qualifier. Nov 15: preliminary.
TPCTF_STAGE=qualifier
TPCTF_MODEL_PROTOCOL=anthropic
MODEL_NAME=GLM-5.1
# Qualifier: use the actual provider's complete Anthropic-compatible endpoint/key.
# Preliminary: replace BOTH with the platform session's generated values (pk_ key).
ANTHROPIC_BASE_URL=https://REPLACE_WITH_ACTUAL_ENDPOINT
ANTHROPIC_API_KEY=REPLACE_WITH_KEY
# Preliminary: exact hostname from ANTHROPIC_BASE_URL, without https:// or a path.
TPCTF_GATEWAY_HOST=

# For OpenAI-compatible models instead: TPCTF_MODEL_PROTOCOL=openai, then set BOTH.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Start with one target. The runner also applies stage/team limits automatically.
TPCTF_CONCURRENCY=1
TPCTF_VPN_MODE=auto
TPCTF_RUNTIME=runtime/tpctf
TPCTF_QUESTION_SECONDS=600
TPCTF_CHALLENGE_SECONDS=1800
TPCTF_QUESTION_ATTEMPTS=2
SOLVER_REQUEST_LIMIT=80
SOLVER_TOKEN_LIMIT=2000000
MAX_OUTPUT_TOKENS=16384
MODEL_TIMEOUT=120
SANDBOX_IMAGE=ctf-sandbox:tpctf-p0
CONTAINER_MEMORY_LIMIT=4g
CONTAINER_CPUS=2
