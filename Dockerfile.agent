# CTF Agent — main controller image (runs the agent orchestrator, NOT the sandbox).
# Build: docker build -f Dockerfile.agent -t ctf-agent .
# Run:   mount the project (contains .env) and the Docker socket; never pass keys on the CLI:
#        docker run --rm -v "<project>:/work" -v "//var/run/docker.sock:/var/run/docker.sock" ctf-agent

FROM python:3.14-slim
COPY --from=ghcr.io/astral-sh/uv:0.13.8 /uv /usr/local/bin/uv

ENV DEBIAN_FRONTEND=noninteractive
ENV TERM=xterm

WORKDIR /app

# ── Install Python dependencies ──────────────────────────────────────────────
COPY pyproject.toml uv.lock ./
COPY backend/ backend/
COPY sandbox/ sandbox/
COPY scripts/ scripts/
COPY tests/ tests/

RUN uv sync --frozen --no-dev
ENV PATH="/app/.venv/bin:$PATH"

# ── Default entrypoint ───────────────────────────────────────────────────────
ENTRYPOINT ["python", "-m", "backend.cli"]
