# ── CTFd Platform ──────────────────────────────────────────────────────────
CTFD_URL=https://ctf.example.com
CTFD_TOKEN=ctfd_your_api_token_here

# ── GLM-5.1 / Anthropic-Compatible Model ──────────────────────────────────
# The primary model for the competition.
# ANTHROPIC_BASE_URL: Anthropic Messages-compatible endpoint.
#   Zhipu example: https://open.bigmodel.cn/api/anthropic
#   (Do NOT use the OpenAI-compatible /api/paas/v4 endpoint.)
# ANTHROPIC_API_KEY: Your API key (DO NOT commit this to git)
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=

# ── Model Configuration ───────────────────────────────────────────────────
MODEL_NAME=GLM-5.1
MODEL_TIMEOUT=300
MAX_OUTPUT_TOKENS=128000
MAX_RETRIES=3
MAX_CONCURRENCY=5
API_RETRY_DELAY=1.0

# ── Budget Limits ──────────────────────────────────────────────────────────
MAX_COST_PER_CHALLENGE=10.0
MAX_COST_TOTAL=500.0
MAX_ATTEMPTS_PER_CHALLENGE=10

# Pricing in USD per 1M tokens. Leave 0 if unknown; cost tracking then reports
# $0 and cost-based budget limits cannot trigger (attempt limits still apply).
MODEL_INPUT_PRICE_PER_MTOK=0
MODEL_CACHED_INPUT_PRICE_PER_MTOK=0
MODEL_OUTPUT_PRICE_PER_MTOK=0

# ── Sandbox / concurrency ──────────────────────────────────────────────────
SANDBOX_IMAGE=ctf-sandbox
MAX_CONCURRENT_CHALLENGES=10
CONTAINER_MEMORY_LIMIT=16g
CONTAINER_CPUS=2.0

# ── Docker-in-Docker path mapping (normally set by scripts/run-agent.ps1) ──
# WORKSPACE_ROOT: project mount inside the agent container (e.g. /work)
# SANDBOX_BIND_ROOT: same directory as seen by the host Docker daemon
WORKSPACE_ROOT=
SANDBOX_BIND_ROOT=

# ── Alternative API Keys (optional, for multi-provider setups) ─────────────
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Provider-specific (optional, for Bedrock/Azure fallback) ──────────────
AWS_REGION=us-east-1
AWS_BEARER_TOKEN=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
OPENCODE_ZEN_API_KEY=
